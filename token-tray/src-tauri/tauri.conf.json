{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "token-tray",
  "version": "0.1.1",
  "identifier": "com.token-tray.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Token 概览",
        "width": 140,
        "height": 38,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "transparent": true,
        "visible": false
      },
      {
        "label": "details",
        "title": "Token 详情",
        "width": 380,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxRkE0RDQwQjc0NEI0MUMKUldRY3RFUzNRRTM2UVZpbmxKZ09vRjV2TjRYZ003VVR1S3hGODU4MGJvc3JlM1NmbmxzVmpMOEkK",
      "endpoints": [
        "https://github.com/kaliluying/token-tray/releases/latest/download/latest.json"
      ]
    }
  }
}
